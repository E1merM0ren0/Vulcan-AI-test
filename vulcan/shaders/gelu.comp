#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float b0[]; };
layout(binding = 1, std430) buffer B1 { float b1[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint pad2; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.cols) return;
    float x = b0[i];
    float c = sqrt(2.0f / 3.14159265358979323846f);
    b1[i] = 0.5f * x * (1.0f + tanh(c * (x + 0.044715f * x * x * x)));
}
