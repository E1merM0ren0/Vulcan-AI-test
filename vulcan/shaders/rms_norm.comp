#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float X[]; };
layout(binding = 1, std430) readonly buffer B1 { float W[]; };
layout(binding = 2, std430) buffer B2 { float O[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint epsBits; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.cols) return;
    uint r = i / pc.cols;
    uint c = i % pc.cols;
    float sum = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        float x = X[r * pc.cols + j];
        sum += x * x;
    }
    float denom = sqrt(sum / float(pc.cols) + uintBitsToFloat(pc.epsBits));
    O[i] = X[i] / denom * W[c];
}
