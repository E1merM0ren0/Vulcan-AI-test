#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float a[]; };
layout(binding = 1, std430) readonly buffer B1 { float b[]; };
layout(binding = 2, std430) buffer B2 { float outM[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint pad2; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.n) return;
    float s = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        float d = a[r * pc.cols + j] - b[r * pc.cols + j];
        s += d * d;
    }
    outM[r] = s / float(pc.n * pc.cols);
}
