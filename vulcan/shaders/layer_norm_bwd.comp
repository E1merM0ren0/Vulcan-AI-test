#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float X[]; };
layout(binding = 1, std430) readonly buffer B1 { float W[]; };
layout(binding = 2, std430) readonly buffer B2 { float dO[]; };
layout(binding = 3, std430) buffer B3 { float dX[]; };
layout(binding = 4, std430) buffer B4 { float dwP[]; };
layout(binding = 5, std430) buffer B5 { float dbP[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint epsBits; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.cols) return;
    uint r = i / pc.cols;
    uint c = i % pc.cols;
    float mean = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        mean += X[r * pc.cols + j];
    }
    mean /= float(pc.cols);
    float var = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        float d = X[r * pc.cols + j] - mean;
        var += d * d;
    }
    var /= float(pc.cols);
    float s = sqrt(var + uintBitsToFloat(pc.epsBits));
    float sumg = 0.0f;
    float sumgx = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        float xj = X[r * pc.cols + j] - mean;
        float wj = dO[r * pc.cols + j] * W[j];
        sumg += wj;
        sumgx += wj * xj;
    }
    float x = X[i] - mean;
    dX[i] = dO[i] * W[c] / s - sumg / (float(pc.cols) * s) - x * sumgx / (float(pc.cols) * s * s * s);
    dwP[i] = dO[i] * x / s;
    dbP[i] = dO[i];
}
