#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float ids[]; };
layout(binding = 1, std430) readonly buffer B1 { float dO[]; };
layout(binding = 2, std430) buffer B2 { float dTable[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint V; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.V * pc.cols) return;
    uint v = i / pc.cols;
    uint c = i % pc.cols;
    float acc = 0.0f;
    for (uint r = 0u; r < pc.n; r++) {
        if (int(ids[r]) == int(v)) acc += dO[r * pc.cols + c];
    }
    dTable[v * pc.cols + c] = acc;
}
