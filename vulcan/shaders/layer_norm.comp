#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float X[]; };
layout(binding = 1, std430) readonly buffer B1 { float W[]; };
layout(binding = 2, std430) readonly buffer B2 { float B[]; };
layout(binding = 3, std430) buffer B3 { float O[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint epsBits; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.cols) return;
    uint r = i / pc.cols;
    uint c = i % pc.cols;
    float mean = 0.0f;
    float var = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        mean += X[r * pc.cols + j];
    }
    mean /= float(pc.cols);
    for (uint j = 0u; j < pc.cols; j++) {
        float d = X[r * pc.cols + j] - mean;
        var += d * d;
    }
    var /= float(pc.cols);
    float denom = sqrt(var + uintBitsToFloat(pc.epsBits));
    O[i] = (X[i] - mean) / denom * W[c] + B[c];
}
