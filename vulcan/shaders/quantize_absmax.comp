#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float X[]; };
layout(binding = 1, std430) buffer B1 { float outQ[]; };
layout(binding = 2, std430) buffer B2 { float sx[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint pad2; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.cols) return;
    uint r = i / pc.cols;
    uint c = i % pc.cols;
    float mx = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        mx = max(mx, abs(X[r * pc.cols + j]));
    }
    if (mx == 0.0f) {
        sx[r] = 0.0f;
        outQ[i] = 0.0f;
        return;
    }
    float s = mx / 127.0f;
    sx[r] = s;
    float q = roundEven(X[i] / s);
    q = clamp(q, -127.0f, 127.0f);
    outQ[i] = q;
}
