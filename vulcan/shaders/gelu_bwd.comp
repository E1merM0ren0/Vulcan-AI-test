#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float x[]; };
layout(binding = 1, std430) readonly buffer B1 { float dO[]; };
layout(binding = 2, std430) buffer B2 { float dX[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint pad2; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.cols) return;
    float xv = x[i];
    float c = sqrt(2.0f / 3.14159265358979323846f);
    float u = c * (xv + 0.044715f * xv * xv * xv);
    float t = tanh(u);
    float dudx = c * (1.0f + 3.0f * 0.044715f * xv * xv);
    float d = 0.5f * (1.0f + t) + 0.5f * xv * (1.0f - t * t) * dudx;
    dX[i] = dO[i] * d;
}
