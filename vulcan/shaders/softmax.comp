#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float b0[]; };
layout(binding = 1, std430) buffer B1 { float b1[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint pad2; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.cols) return;
    uint r = i / pc.cols;
    float m = -3.402823466e+38f;
    for (uint j = 0u; j < pc.cols; j++) {
        m = max(m, b0[r * pc.cols + j]);
    }
    float s = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        s += exp(b0[r * pc.cols + j] - m);
    }
    b1[i] = exp(b0[i] - m) / s;
}
