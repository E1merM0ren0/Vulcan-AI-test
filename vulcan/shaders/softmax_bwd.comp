#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0, std430) readonly buffer B0 { float probs[]; };
layout(binding = 1, std430) readonly buffer B1 { float dO[]; };
layout(binding = 2, std430) buffer B2 { float dX[]; };
layout(push_constant) uniform PC { uint n; uint cols; uint pad2; uint pad3; uint pad4; uint pad5; uint pad6; uint pad7; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.cols) return;
    uint r = i / pc.cols;
    float dot = 0.0f;
    for (uint j = 0u; j < pc.cols; j++) {
        dot += dO[r * pc.cols + j] * probs[r * pc.cols + j];
    }
    dX[i] = probs[i] * (dO[i] - dot);
}
